{
  "g++17.O2": {
    "name": "g++17 -O2 -static",
    "build_command": "g++ -o {output} {source_path} -O2 -static -std=c++17 {defines}"
  },
  "g++17.Ofast.skylake": {
    "name": "g++17 -Ofast -static -march=skylake",
    "build_command": "g++ -o {output} {source_path} -Ofast -static -march=skylake -std=c++17 {defines}"
  }
}
